# Copy this file to server/.env.test and fill in YOUR OWN values.
# This must point to a SEPARATE, EMPTY database (never your real/demo one):
# the tests create, approve and reject orders, and approved orders can never
# be deleted because the audit log is append-only.
#
# Use the Supabase "Session pooler" URI (port 5432). Keep the password to
# letters and numbers only; characters like @ # / ? break the URL.
DATABASE_URL=postgresql://postgres.TESTPROJECTID:TestPassword123@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
JWT_SECRET=any_long_random_string_for_tests